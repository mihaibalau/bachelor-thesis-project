# Copy to .env and adjust for your local Postgres instance.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gentlix_bank
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Logging (see backend/LOGGING.md)
# LOG_FORMAT=text          # use json on AWS CloudWatch
# DEBUG_MODE=1             # verbose debug logging
# RUST_LOG=info,rust=debug,tower_http=warn
# SERVICE_NAME=gentlix-rust
# PORT=6767
