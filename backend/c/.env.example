# Copy to .env (run the C server from backend/c so load_dotenv finds this file).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gentlix_bank
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Logging (see backend/LOGGING.md)
# LOG_FORMAT=text          # use json on AWS CloudWatch
# DEBUG_MODE=1             # verbose debug logging
# LOG_LEVEL=info           # trace | debug | info | warn | error
# SERVICE_NAME=gentlix-c
# PORT=6767
