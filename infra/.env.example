# Copy to infra/.env and adjust. Used by docker-compose.yml.
# Do NOT commit infra/.env with real values.

# --- Postgres ---
POSTGRES_USER=mihai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gentlix_bank
POSTGRES_PORT=5432

# --- Backend (rust / c) ---
# REQUIRED: a long random secret shared by whichever backend you run.
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Logging (see backend/LOGGING.md)
LOG_FORMAT=text
RUST_LOG=info,tower_http=warn
LOG_LEVEL=info

# --- Frontend (build-time, baked into the bundle) ---
VITE_API_BASE_URL=http://localhost:6767/api
FRONTEND_PORT=5173
